// Editor feedback on the frontmatter of the project pages, from the "Frontmatter Schema" Zed
// extension (https://git.red.bloomyindev.me/bastien/zed-frontmatter-schema). The schema is
// generated and not committed: `pnpm dev` or `pnpm run schema` creates it.
{
    "lsp": {
        "frontmatter-schema": {
            "settings": {
                "schemas": {
                    "./schemas/project.json": ["src/content/projects/data/*.md"]
                }
            }
        }
    }
}
