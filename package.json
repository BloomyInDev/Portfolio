{
    "name": "portfolio-bastien-luben",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.13.1",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "pnpm run type-check && pnpm run build-only",
